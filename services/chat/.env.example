# 令牌与外部服务地址（敏感，走 env 层；本文件已被 .gitignore 排除）
# OPENAI_API_KEY 留空时，/api/langchain/* 路由返回 503 提示
# 填入你的 GLM 开放平台 API Key（bigmodel 控制台获取）后即可真实调用
OPENAI_API_KEY=
# OpenAI 兼容网关地址（与 llm.model 配套更换）：
#   GLM:      https://open.bigmodel.cn/api/paas/v4        （model 用 glm-4-flash / glm-4.6 等）
#   DeepSeek: https://api.deepseek.com                     （model 用 deepseek-chat 等）
#   OpenAI:   https://api.openai.com/v1                    （model 用 gpt-4o-mini 等）
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=
